{
  "name": "dsh-sang-prompts",
  "version": "0.1.10",
  "type": "module",
  "description": "桑的提示词：安装后替换系统提示词，并在进入项目目录时写入项目规程",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "prompts"
  ],
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "prompts",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "displayName": "桑的提示词",
    "pluginType": "suite",
    "compatibility": {
      "dsh": ">=0.2.1-rc.2"
    }
  }
}
